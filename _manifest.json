{
  "manifest_version": 2,
  "version": "4.1.0",
  "name": "B站视频插件 Maisaka 版",
  "description": "让麦麦像人类一样看视频，支持自动检测、命令模式、视觉分析、字幕与 ASR。",
  "author": {
    "name": "白泽",
    "url": "https://github.com/Mettafy"
  },
  "license": "AGPL-3.0-or-later",
  "urls": {
    "repository": "https://github.com/Mettafy/bilibili_video_parser",
    "homepage": "https://github.com/Mettafy/bilibili_video_parser",
    "documentation": "https://github.com/Mettafy/bilibili_video_parser",
    "issues": "https://github.com/Mettafy/bilibili_video_parser/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.0.0"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "send.text",
    "api.call",
    "config.get",
    "database.get",
    "llm.generate",
    "llm.get_available_models"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "locales_path": "_locales",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "id": "mettafy.bilibili-video-parser-maisaka"
}
